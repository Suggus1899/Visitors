#!/bin/sh
# Husky pre-commit hook (v9)
# Runs lint, type-check, and tests on staged changes

set -e

# Gather staged files
staged=$(git diff --cached --name-only)

# If no code files changed, skip
echo "$staged" | grep -qE '\.(ts|tsx|js|jsx|json|yml|yaml|sh|bat|ps1|go|sql|mod|sum)$' || {
  echo "husky - no code files staged, skipping checks"
  exit 0
}

client=0; server=0; backend_go=0
for f in $staged; do
  case "$f" in client/*) client=1 ;; server/*) server=1 ;; server-go/*) backend_go=1 ;; esac
done

if [ "$backend_go" = 1 ]; then
  echo "--- Checking Go backend ---"
  (cd server-go && go vet ./... && go test ./...)
fi

if [ "$client" = 1 ]; then
  echo "--- Checking client ---"
  cd client
  [ -d node_modules ] || pnpm install --frozen-lockfile
  pnpm run lint && pnpm exec tsc --noEmit && pnpm test
  cd ..
fi

if [ "$server" = 1 ]; then
  echo "--- Checking server ---"
  cd server
  [ -d node_modules ] || pnpm install --frozen-lockfile
  pnpm exec tsc --noEmit && pnpm test
  cd ..
fi
