# LogMaster Go. Plantilla pública; no contiene credenciales utilizables.
# Para el entorno local: pnpm local:setup genera .env.logmaster-*.local.
# Seleccionar un archivo privado con DOTENV_CONFIG_PATH. No copiar claves entre
# bases existentes: una adopción conserva sus claves originales.
HTTP_HOST=127.0.0.1
PORT=3000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=logmaster_go_dev
DB_USER=REPLACE_WITH_LOCAL_ROLE
DB_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
DB_SSL=false

# Generar secretos aleatorios propios. ENCRYPTION_KEY: 32 bytes hexadecimales.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
# JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
ENCRYPTION_KEY=REPLACE_WITH_64_HEXADECIMAL_CHARACTERS
EDIT_PASSWORD=REPLACE_WITH_PRIVATE_EDIT_PASSWORD

BACKUP_PATH=../Visitors-local/backups/go_dev
BACKUP_PASSWORD=REPLACE_WITH_PRIVATE_BACKUP_KEY
# PG_BIN_PATH=F:/Proyectos/Visitors-local/pgsql/bin
RETENTION_ENABLED=false
DATA_RETENTION_DAYS=60
AUDIT_LOG_RETENTION_DAYS=365
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Buzón local: no entrega mensajes a destinatarios externos.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=logmaster@example.test
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Solo para seed explícito en bases locales nuevas. Generar contraseñas únicas
# de 12 caracteres o más, con mayúscula, minúscula, número y símbolo.
SEED_ROOT_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
SEED_ADMIN_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
SEED_OPERADOR_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
SEED_GUARD_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
SEED_AUDITOR_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
SEED_DEMO_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
