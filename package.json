{
  "name": "logmaster",
  "version": "1.0.0",
  "description": "LogMaster - Sistema de Control de Acceso de Visitantes",
  "scripts": {
    "dev": "docker compose --profile test up --build",
    "start": "docker compose up -d --wait",
    "server": "docker compose up api",
    "server:legacy": "pnpm --dir server run dev",
    "start:legacy": "cross-env NODE_OPTIONS=--no-warnings concurrently --kill-others-on-fail \"pnpm run server:legacy\" \"pnpm run client\"",
    "client": "pnpm --dir client run dev",
    "install-all": "pnpm install",
    "test:server": "cd server-go && go test ./...",
    "test:legacy": "pnpm --dir server run test",
    "test:client": "pnpm --dir client run test",
    "test": "pnpm run test:server && pnpm run test:client",
    "build:server": "cd server-go && go build -trimpath -o ../dist/ ./cmd/logmaster",
    "typecheck:legacy": "pnpm --dir server exec tsc -p tsconfig.json --noEmit",
    "build:client": "pnpm --dir client run build",
    "build": "pnpm run build:client && pnpm run build:server",
    "backup": "pwsh -NoProfile -File scripts/run-go.ps1 -Mode backup",
    "backup:monitor": "pwsh -NoProfile -File scripts/run-go.ps1 -Mode backup-monitor",
    "local:setup": "sh scripts/containers/configure.sh",
    "local:prepare": "docker compose run --rm ops migrate && docker compose run --rm ops seed",
    "local:start": "docker compose --profile test up -d --wait",
    "local:prepare:legacy": "pwsh -NoProfile -File scripts/run-local.ps1 -Mode prepare",
    "local:start:legacy": "pwsh -NoProfile -File scripts/run-local.ps1 -Mode start",
    "test:integration": "pwsh -NoProfile -File scripts/run-go.ps1 -Mode test",
    "test:integration:legacy": "pwsh -NoProfile -File scripts/run-local.ps1 -Mode test",
    "typecheck:client": "pnpm --dir client exec tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3"
  },
  "author": "Gustavo Colina (@Suggus1899)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.2"
}
